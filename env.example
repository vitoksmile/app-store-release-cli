# App Store Connect API Credentials
# Copy this file to .env (or env) in your project root or alongside release.sh:
#   cp env.example .env

# Your App Store Connect API Key ID (10 alphanumeric characters)
ASC_KEY_ID="2X9R4HXF34"

# Your App Store Connect Issuer ID (UUID format from Users and Access -> Integrations)
ASC_ISSUER_ID="57246542-96fe-1a63-e053-0824d011072a"

# Path to your private key file (.p8 downloaded from Apple)
# Relative paths are checked in project root, script directory, and ~/.appstoreconnect/private_keys/
ASC_KEY_FILE="AuthKey_2X9R4HXF34.p8"

# Optional: Default App Bundle ID (can also be passed via --bundle-id)
# APP_BUNDLE_ID="com.example.myapp"

# Optional: Default metadata CSV file (can also be passed via --csv)
# APP_METADATA_CSV="app_store_metadata.csv"
